.mkdocs-shared/
docs/stylesheets/
docs/javascript/
docs/images/favicon.svg

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
