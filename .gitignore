# Documentation build artifacts.
#
# These are staged from design-system/ at build time. A committed copy would
# start overriding the shared source, so they must never be tracked.
site/
.mkdocs-shared/
docs/stylesheets/
docs/javascript/
docs/images/favicon.svg

# Theme overrides staged from design-system/overrides/. Staging is
# no-clobber, so a committed copy would freeze this repo on an old version
# of a shared partial. To genuinely override one, remove its line here and
# commit the file deliberately.
overrides/main.html
overrides/partials/
overrides/.icons/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Recall session logs — never publish these.
.recall/
