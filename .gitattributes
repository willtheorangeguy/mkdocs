# Normalize line endings.
#
# Without this, files authored on Windows are checked out with CRLF on the
# Linux runners. `docs-serve.sh` fails outright ("bad interpreter") and the
# YAML block scalars in the workflows carry stray carriage returns into the
# shell.

* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# PowerShell is the one script that wants CRLF.
*.ps1 text eol=crlf
